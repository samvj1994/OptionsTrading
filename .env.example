# Copy this file to .env and fill in the Groww credentials for one authentication method.
# Use GROWW_API_SECRET for API-key/secret approval, or GROWW_TOTP_SECRET for TOTP.
# Do not set both methods. Never share .env or commit it.
GROWW_API_KEY=
GROWW_API_SECRET=
GROWW_TOTP_SECRET=
OI_MIN_ABSOLUTE_DELTA=0.45
OI_MAX_ABSOLUTE_DELTA=0.70
OI_MAX_BID_ASK_SPREAD_PERCENT=2.0
OI_RSI_BULLISH_THRESHOLD=55
OI_RSI_BEARISH_THRESHOLD=45
OI_MIN_CANDIDATE_SCORE=65
OI_STRONG_CANDIDATE_SCORE=80
# Score weights must total 100.
OI_SCORE_WEIGHT_PREMIUM=20
OI_SCORE_WEIGHT_TREND=20
OI_SCORE_WEIGHT_LIQUIDITY=15
OI_SCORE_WEIGHT_OI=15
OI_SCORE_WEIGHT_VOLATILITY=15
OI_SCORE_WEIGHT_GREEKS=10
OI_SCORE_WEIGHT_RISK_REWARD=5
